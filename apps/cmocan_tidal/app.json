{
  "id": "cmocan_tidal",
  "title": "TIDAL",
  "description": "A personal TIDAL player: your favourites, playlists, mixes and search, played on the car's speakers. Sign in once from the phone (QR code). Skip on the steering wheel goes to the next or the previous track. Needs the cmocan-tidal service.",
  "version": "0.1.0",
  "vendor": "custom",
  "loggingId": "OAT1",
  "iconGlyph": "TDL",
  "signals": {
    "de.bmw.infotainment.controlelements.SteeringWheelPushButton": {
      "_instances": "1",
      "statusSearchSwitch1": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "org.genivi.am.commandinterface.CommandControl": {
      "_instances": "1",
      "_methods": ["connect", "disconnect", "getListMainConnections", "getListMainSinks"],
      "_broadcasts": ["volumeChanged", "sinkMuteStateChanged"]
    },
    "org.genivi.am.routinginterface.RoutingControlObserver": {
      "_instances": "1",
      "_methods": ["hookSourceAvailablityStatusChange"]
    }
  },
  "screens": [
    { "name": "MAIN", "kind": "canvas", "title": "TIDAL",
      "buttons": [["BTN_PLAY", "Play / Pause"], ["BTN_PREV", "Previous"], ["BTN_NEXT", "Next"], ["BTN_LIBRARY", "Library"], ["BTN_SETTINGS", "Settings"]] }
  ],
  "settings": [
    { "key": "quality", "label": "Sound quality (from the next track)", "type": "choice", "default": "LOSSLESS",
      "options": [["LOSSLESS", "Lossless (FLAC 16-bit 44.1 kHz)"], ["HIGH", "High (AAC 320 kbit/s)"]] },
    { "key": "wheel", "label": "Skip on the steering wheel: next / previous track (while a track plays)", "type": "bool", "default": true }
  ]
}
