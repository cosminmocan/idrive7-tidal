{
  "id": "cmocan_tidal",
  "title": "TIDAL",
  "description": "A personal TIDAL player: your favourites, playlists, mixes and search, played on the car's speakers. Sign in once from the phone (QR code). Skip on the steering wheel goes to the next or the previous track; held, it winds. Needs the cmocan-tidal service.",
  "version": "0.1.1",
  "mguHmi": ["ID7"],
  "requires": { "cmocan-tidal": "0.1.2", "mgu-deploy": "0.7.0", "mgu-render": "0.6.26" },
  "vendor": "custom",
  "loggingId": "OAT1",
  "iconGlyph": "TDL",
  "signals": {
    "de.bmw.infotainment.controlelements.SteeringWheelPushButton": {
      "_instances": "1",
      "statusSearchSwitch1": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs"
    },
    "org.genivi.am.commandinterface.CommandControl": {
      "_instances": "1",
      "_methods": ["connect", "disconnect", "getListMainConnections", "getListMainSinks"],
      "_broadcasts": ["volumeChanged", "sinkMuteStateChanged"]
    },
    "org.genivi.am.routinginterface.RoutingControlObserver": {
      "_instances": "1",
      "_methods": ["hookSourceAvailablityStatusChange"]
    }
  },
  "screens": [
    { "name": "MAIN", "kind": "canvas", "title": "TIDAL",
      "buttons": [["BTN_UP", "Up"], ["BTN_DOWN", "Down"], ["BTN_OK", "Select"], ["BTN_PREVIOUS", "Previous"],
                  ["BTN_PLAY", "Play"], ["BTN_NEXT", "Next"], ["BTN_LIBRARY", "Library"], ["BTN_SETTINGS", "Settings"]] }
  ],
  "settings": [
    { "key": "quality", "label": "Sound quality (from the next track)", "type": "choice", "default": "HIGH",
      "options": [["HIGH", "High (AAC 320)"], ["LOSSLESS", "Lossless (FLAC), plays as High for now"]] },
    { "key": "wheel", "label": "Steering wheel: press for next / previous track, hold to wind (while a track plays)", "type": "bool", "default": true },
    { "key": "cluster", "label": "Show the track on the instrument cluster", "type": "bool", "default": true },
    { "key": "hmiBack", "label": "Back arrow: one level up in lists (trial)", "type": "bool", "default": false },
    { "key": "videoParkedOnly", "label": "Picture only while parked", "type": "bool", "default": false },
    { "key": "videoHeight", "label": "Video size (from the next video)", "type": "choice", "default": "720",
      "options": [["480", "480p"], ["720", "720p"], ["1080", "1080p"]] }
  ]
}
